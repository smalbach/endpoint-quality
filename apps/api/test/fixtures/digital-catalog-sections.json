        "parameters": {
          "lat": "4.6482",
          "lon": "-74.0648",
          "radius_km": "20"
        },
        "requiresParameters": [
          "lat"
        ]
      },
      {
        "id": "geo-default",
        "name": "Radio geográfico por defecto",
