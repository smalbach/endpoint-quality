# --- API ---
# El puerto de cada implementación. Las tres corren a la vez contra la misma base de datos y con
# los mismos secretos, que es lo que hace que el selector del front pueda cambiar de una a otra sin
# cerrar la sesión. Ver docs/backends-poliglotas.md.
PORT=3001                      # NestJS (la implementación de referencia)
PORT_PY=3002                   # FastAPI
PORT_GO=3003                   # Go
DATABASE_URL=postgres://eq:eq@localhost:5432/endpoint_quality
QUEUE_DRIVER=memory            # memory | redis
# Con REDIS_URL, además, las instancias de la API se hablan por Redis pub/sub (progreso en vivo,
# órdenes a sesiones de canal, cancelar/pausar) y cuentan los límites de peticiones en el mismo
# sitio (si Redis cae, cada una cuenta en su memoria hasta que vuelva). Sin él, bus y contadores en
# memoria: un solo proceso. «Una corrida de seguridad/rendimiento a la vez» va por Postgres siempre.
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Cifrado de credenciales del target y de las variables secretas (AES-256-GCM, 32 bytes en base64) ---
SECRETS_KEY=

# --- Guardas de red del motor de ejecucion (ver docs/decoupling-plan.md 4.8) ---
# true SOLO en self-hosted donde el target vive en la red privada del usuario.
ALLOW_PRIVATE_TARGETS=false
MAX_REDIRECTS=3
REQUEST_TIMEOUT_MS=12000
MAX_RESPONSE_BYTES=5242880

# --- Tope de tamano de una corrida ---
# Los topes locales (500 filas de datos, 50 flujos por suite, 200 vueltas de bucle) se multiplican.
# Este es el unico que mira el total.
MAX_RUN_CASES=5000

# --- Retencion de corridas (dias; 0 es "nunca") ---
# `run_steps` es la tabla que crece: un caso create-read son tres filas y cada una guarda un cuerpo
# de respuesta entero. Los cuerpos se retiran primero; el veredicto (aserciones, etiquetas,
# duraciones) sobrevive mucho mas y es lo que hace que una corrida vieja siga contestando algo.
RETENTION_BODIES_DAYS=30
RETENTION_RUNS_DAYS=365
RETENTION_SWEEP_HOURS=6

# --- Web ---
# Sin valor, el front habla con `/api`, `/api-py` y `/api-go` del mismo origen, que es lo que
# necesita la cookie de refresco (`SameSite=Strict`). En desarrollo los proxea Vite; en Docker,
# nginx. Definir estas variables solo hace falta si sirves el front desde otro sitio.
VITE_API_URL=http://localhost:3001
