{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"]
}
