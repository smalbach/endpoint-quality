node_modules/
dist/
# La suite de la API se compila a dist-test/ antes de correr. Se coló en un commit de P5
# porque el patrón de arriba solo casa `dist/`.
dist-test/
build/
coverage/
.turbo/
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store

# Los ficheros de veredictos del corte de paridad: evidencia de una ejecución, no fuente.
.parity-cut/

# Los secretos que scripts/demo.sh genera para el compose.
docker/.env

# Worktrees de los agentes en segundo plano. Son clones del propio repo.
.claude/worktrees/

# El entorno del backend de Python y lo que deja el intérprete al correrlo. Igual que
# `node_modules/`: se reconstruye desde el manifiesto, no se versiona.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# La credencial de /metrics para Prometheus: se genera por instalación (ver docker/observability/README.md).
docker/observability/metrics-token
