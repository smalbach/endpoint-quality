# Lo que el compose lee. `scripts/demo.sh` genera este fichero solo si no existe.
#
# Los tres secretos no tienen valor por defecto a propósito: la API se niega a arrancar sin ellos.
# Un valor de ejemplo en un fichero versionado acaba siendo el de producción de alguien, y firma
# las sesiones de todo el mundo con la misma clave.
#
#     openssl rand -base64 48 | tr -d '\n='

# Firman los tokens de sesión. Cambiarlos cierra la sesión de todo el mundo.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cifra las credenciales de los destinos (AES-256-GCM). PERDERLA ES PERDERLAS: no hay forma de
# descifrarlas sin ella, que es la única propiedad que hace que guardarlas valga la pena.
SECRETS_KEY=

# El motor pide URLs que escribe quien usa el producto. En `true`, cualquiera con una cuenta puede
# apuntarlo a la red interna de quien hospeda esto —metadatos de la nube, bases de datos, paneles—
# y leer la respuesta. Solo en `true` si el producto y los destinos viven en la misma máquina.
ALLOW_PRIVATE_TARGETS=false

# `memory` ejecuta la cola en el propio proceso, sin infraestructura; una corrida muere si la API
# se reinicia. `redis` es lo que quiere una instancia compartida (y el perfil `redis` del compose).
QUEUE_DRIVER=memory

# Solo si sirves la interfaz desde otro origen. Por defecto va detrás de /api en el mismo, que es
# lo que hace que SameSite=Strict signifique algo.
# CORS_ORIGINS=https://eq.example.com

# Puertos publicados hacia fuera, por si alguno está ocupado.
# EQ_WEB_PORT=8080
# EQ_API_PORT=3001
# EQ_POSTGRES_PORT=5432
